#!/usr/bin/env bash
# Runs the Aether core as a local SOCKS5 proxy, restarting it if it exits. Installing and
# updating Aether is install/core/aether.sh's job. The flags are the 8VPN Windows GUI
# defaults: MASQUE over HTTP/2 is what survives filtering, a bare `aether` does not.
AETHER_DIR="${AETHER_DIR:-$HOME/.local/share/aether}"
AETHER_PORT="${AETHER_PORT:-1819}"

cd "$AETHER_DIR" || exit 1
while true; do
  echo "[$(date +%T)] starting aether (first scan can take a few minutes)"
  ./aether --protocol masque --h2 --scan turbo -4 --no-quick-reconnect \
    --bind "127.0.0.1:$AETHER_PORT" || true
  echo "[$(date +%T)] aether exited, restarting in 5s (Ctrl+C to stop)"
  sleep 5
done
