{
    "layer": "top",
    "reload_style_on_change": true,
    "position": "top",
    "height": 18,
    "spacing": 2,
    "margin-top": 4,
    "margin-left": 6,
    "margin-right": 6,

    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "custom/move_workspace",
    ],

    "modules-center": [
        "clock",
    ],

    "modules-right": [
        "custom/ping",
        "custom/vpn",
        "custom/notifications",
        "group/group-stats",
        "wireplumber",
        "backlight",
        "battery",
        "tray",
        "group/group-power",
    ],

    "custom/launcher": {
        "format": "",
        "tooltip": false,
        "on-click": "pkill -x rofi || rofi -show drun"
    },

    "clock": {
        "format": "{:%H:%M:%S. %a}",
        "format-alt": "{:%B %m/%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "interval": 1,
    },

    "hyprland/workspaces": {
        "active-only": false,
        "format": "{name}",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"+1\" })'",
  },
    "custom/move_workspace": {
      "format": "->",
      "on-click": "hyprctl dispatch 'hl.dsp.workspace.move({ monitor = \"+1\" })'",
      "tooltip": false
    },
    "custom/vpn": {
      "format": "VPN: {}",
      "on-click": "hyprctl dispatch 'hl.dsp.workspace.toggle_special(\"vpn\")'",
      "exec": "~/.config/waybar/scripts/vpn_status.sh tun0",
      "return-type": "json",
      "interval": 5
    },

    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "on-click": "~/.config/waybar/scripts/switch_backlight.sh",
        "on-click-right": "~/.config/waybar/scripts/montior_toggle.sh"
    },

    "custom/notifications": {
        "format": "󰂚",
        "tooltip": false,
        "on-click": "qs -p $HOME/.config/quickshell/notifd ipc call notifd toggleHistory",
        "on-click-right": "qs -p $HOME/.config/quickshell/notifd ipc call notifd toggleDnd"
    },

    "custom/ping": {
        "exec": "~/.config/waybar/scripts/ping-status.sh",
        "interval": 1,
        "return-type": "json",
        "format": "{}",
        "tooltip": true
    },
    "tray": {
        "icon-size": 12,
        "spacing": 6
    },


  "group/group-stats": {
    "orientation": "horizontal",
    "drawer": {
        "transition-duration": 500,
        "children-class": "not-power",
        "transition-left-to-right": false,
    },
    "modules": [
        "cpu",
        "memory",
        "temperature",
        "custom/gpu",
    ]
  },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": true
    },
    "custom/gpu": {
        "format": "{}% ",
        "tooltip-format": "{}% used",
        "interval": 5,
        "tooltip": true,
        "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits"
    },

    "memory": {
        "format": "{}% "
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },

    "battery": {
        "states": {
            "good": 100,
            "warning": 95,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-good": "",
        "format-charging": "{capacity}% ",
        "format-icons": ["", "", "", "", ""]
    },

    "wireplumber": {
        "format": "{volume}% {icon}",
        "format-muted": "",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "max-volume": 150,
        "format-icons": ["", "", ""]
    },
    "group/group-power": {
    "orientation": "horizontal",
    "drawer": {
        "transition-duration": 500,
        "children-class": "not-power",
        "transition-left-to-right": false,
    },
    "modules": [
        "custom/power",
        "custom/quit",
        "custom/reboot",
    ]
},
"custom/quit": {
    "format": "󰗼",
    "tooltip": false,
    "on-click": "$HOME/.config/waybar/scripts/confirmation_menu.sh \"Exit Hyprland? \" \"hyprshutdown\""
},
"custom/reboot": {
    "format": "󰜉",
    "tooltip": false,
    "on-click": "$HOME/.config/waybar/scripts/confirmation_menu.sh \"Reboot? \" reboot"
},
"custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": " $HOME/.config/waybar/scripts/confirmation_menu.sh \"Are you sure you wanna TURN YOUR FUCKING PC OFF? \" poweroff"
}

}
