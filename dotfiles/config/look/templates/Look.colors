[Colors:Button]
BackgroundAlternate={{bg_alt|rgb}}
BackgroundNormal={{surface|rgb}}
DecorationFocus={{accent|rgb}}
DecorationHover={{accent_alt|rgb}}
ForegroundActive={{accent|rgb}}
ForegroundInactive={{fg_dim|rgb}}
ForegroundLink={{accent_alt|rgb}}
ForegroundNegative={{danger|rgb}}
ForegroundNeutral={{warn|rgb}}
ForegroundNormal={{fg|rgb}}
ForegroundPositive={{ok|rgb}}
ForegroundVisited={{accent_alt|rgb}}

[Colors:Complementary]
BackgroundAlternate={{surface|rgb}}
BackgroundNormal={{bg_alt|rgb}}
DecorationFocus={{accent|rgb}}
DecorationHover={{accent_alt|rgb}}
ForegroundActive={{accent|rgb}}
ForegroundInactive={{fg_dim|rgb}}
ForegroundLink={{accent_alt|rgb}}
ForegroundNegative={{danger|rgb}}
ForegroundNeutral={{warn|rgb}}
ForegroundNormal={{fg|rgb}}
ForegroundPositive={{ok|rgb}}
ForegroundVisited={{accent_alt|rgb}}

[Colors:Header]
BackgroundAlternate={{bg_alt|rgb}}
BackgroundNormal={{surface|rgb}}
DecorationFocus={{accent|rgb}}
DecorationHover={{accent_alt|rgb}}
ForegroundActive={{accent|rgb}}
ForegroundInactive={{fg_dim|rgb}}
ForegroundLink={{accent_alt|rgb}}
ForegroundNegative={{danger|rgb}}
ForegroundNeutral={{warn|rgb}}
ForegroundNormal={{fg|rgb}}
ForegroundPositive={{ok|rgb}}
ForegroundVisited={{accent_alt|rgb}}

[Colors:Selection]
BackgroundAlternate={{selection|rgb}}
BackgroundNormal={{accent|rgb}}
DecorationFocus={{accent|rgb}}
DecorationHover={{accent_alt|rgb}}
ForegroundActive={{fg|rgb}}
ForegroundInactive={{fg_dim|rgb}}
ForegroundLink={{accent_alt|rgb}}
ForegroundNegative={{danger|rgb}}
ForegroundNeutral={{warn|rgb}}
ForegroundNormal={{bg|rgb}}
ForegroundPositive={{ok|rgb}}
ForegroundVisited={{accent_alt|rgb}}

[Colors:Tooltip]
# Translucent like the window it floats over.
BackgroundAlternate={{surface|rgb}},170
BackgroundNormal={{bg|rgb}},170
DecorationFocus={{accent|rgb}}
DecorationHover={{accent_alt|rgb}}
ForegroundActive={{accent|rgb}}
ForegroundInactive={{fg_dim|rgb}}
ForegroundLink={{accent_alt|rgb}}
ForegroundNegative={{danger|rgb}}
ForegroundNeutral={{warn|rgb}}
ForegroundNormal={{fg|rgb}}
ForegroundPositive={{ok|rgb}}
ForegroundVisited={{accent_alt|rgb}}

[Colors:View]
# Dolphin's alternate rows: a faint tint, since a solid bar would break the translucent view.
BackgroundAlternate={{fg|rgb}},12
BackgroundNormal={{bg|rgb}}
DecorationFocus={{accent|rgb}}
DecorationHover={{accent_alt|rgb}}
ForegroundActive={{accent|rgb}}
ForegroundInactive={{fg_dim|rgb}}
ForegroundLink={{accent_alt|rgb}}
ForegroundNegative={{danger|rgb}}
ForegroundNeutral={{warn|rgb}}
ForegroundNormal={{fg|rgb}}
ForegroundPositive={{ok|rgb}}
ForegroundVisited={{accent_alt|rgb}}

[Colors:Window]
# Translucent so widgets painted with the window color show the blurred window behind.
BackgroundAlternate={{surface|rgb}},170
BackgroundNormal={{bg_alt|rgb}},170
DecorationFocus={{accent|rgb}}
DecorationHover={{accent_alt|rgb}}
ForegroundActive={{accent|rgb}}
ForegroundInactive={{fg_dim|rgb}}
ForegroundLink={{accent_alt|rgb}}
ForegroundNegative={{danger|rgb}}
ForegroundNeutral={{warn|rgb}}
ForegroundNormal={{fg|rgb}}
ForegroundPositive={{ok|rgb}}
ForegroundVisited={{accent_alt|rgb}}

[General]
ColorScheme=Look
Name=Look

[KDE]
contrast=4
